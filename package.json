{
  "name": "asn1js",
  "displayName": "asn1js",
  "description": "Decode ASN.1 content",
  "publisher": "lapo",
  "version": "0.2.1",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ASN",
    "ASN.1",
    "ASN1",
    "DER",
    "BER"
  ],
  "license": "ISC",
  "engines": {
    "vscode": "^1.88.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lapo-luchini/vscode-asn1js.git"
  },
  "icon": "icon.png",
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "node prepublish",
    "lint": "eslint .",
    "pretest": "pnpm run lint",
    "test": "vscode-test"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/compat": "^1.2.8",
    "adm-zip": "^0.5.16",
    "eslint": "^9.24.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "asn1js.decode",
        "title": "Decode ASN.1"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "config.asn1js.allExtensions || resourceFilename =~ /[.](?:pem|der|cer|crt|p7m|p7s|p12|b64)$/",
          "command": "asn1js.decode"
        }
      ]
    },
    "configuration": {
      "title": "asn1js",
      "type": "object",
      "properties": {
        "asn1js.allExtensions": {
          "type": "boolean",
          "default": false,
          "description": "Show the 'Decode ASN.1' option to all file extensions"
        },
        "asn1js.side": {
          "type": "boolean",
          "default": true,
          "description": "Open the decoded ASN.1 window to the side"
        }
      }
    }
  },
  "activationEvents": [
    "onWebviewPanel:asn1js.view"
  ]
}
